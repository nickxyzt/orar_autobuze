<%= render partial: 'menu/menu' %>

<strong>Utilitar: Obtinere orar linii pornind de la short_name din BD</strong>
<div>Nu uita sa modifici zilele cand merge linia (daca sunt exceptii)!</div>
<div class="alert alert-danger"><%= @messages %></div>
<%= form_tag do %>
  <%= select_tag :line_id, options_for_select(Line.all.map {|line| [line.name, line.id]}, @line_id) %>
  <%= submit_tag 'Obtine orar oficial', class: 'btn btn-primary' %>
<% end %>

<%= @obtained_schedule %>
